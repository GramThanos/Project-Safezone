# Environment variables template
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_HOST=db
DATABASE_NAME=safehouse
DATABASE_USER=safehouse
DATABASE_PASSWORD=changeme_secure_password

# Redis Configuration
REDIS_HOST=cache
REDIS_PORT=6379

# SteamCMD Configuration
STEAMCMD_PATH=/home/steam/steamcmd

# Monitoring Configuration
CHECK_INTERVAL=30

# Flask Configuration
FLASK_DEBUG=false
