# Copy this file to .env beside docker-compose.yml and fill in your values.
# Everything else is set in the admin panel, or directly in docker-compose.yml.

# Timezone for container clocks and logs (an IANA name, e.g. Europe/Berlin).
# The daily loot reset follows the primary game server's timezone instead.
TZ=UTC

# --- Secrets: change every one before the host is reachable ---------------------
# Generate each value with e.g. `openssl rand -hex 32`. Set the database ones
# before the first start: MariaDB only reads them when it creates the database.
SECRET_KEY=changeme_secure_secret_key_for_jwt
DATABASE_PASSWORD=changeme_secure_password
DATABASE_ROOT_PASSWORD=changeme_root_password
# Shared by the backend and the game-server manager.
API_TOKEN=changeme_secure_api_token

DATABASE_NAME=safezone
DATABASE_USER=safezone

# Session length in hours. Editable later in the panel.
TOKEN_EXPIRY_HOURS=24

# --- Outbound email -----------------------------------------------------------
# Sent by the game-server container. Blank SMTP_HOST writes mail to the backend
# log instead, which makes password recovery an operator task. All of these can
# also be set in the panel under Settings > Mail, which then wins.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=
