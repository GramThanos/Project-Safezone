# Environment variables template
# Copy this file to .env and fill in your values

# Database Configuration (MariaDB)
DATABASE_HOST=db
DATABASE_NAME=safezone
DATABASE_USER=safezone
DATABASE_PASSWORD=changeme_secure_password
DATABASE_ROOT_PASSWORD=changeme_root_password

# Redis Configuration
REDIS_HOST=cache
REDIS_PORT=6379

# Backend API Configuration
SECRET_KEY=changeme_secure_secret_key_for_jwt
TOKEN_EXPIRY_HOURS=24
TOKEN_ISSUER=safezone-api
TOKEN_AUDIENCE=safezone-frontend

# Security Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
HTTPS_ENABLED=false
FLASK_DEBUG=false
# Global per-IP rate limits (semicolon-separated). Keep generous: the SPA polls
# live status. Raise if you see spurious 429s.
RATELIMIT_DEFAULT=300 per minute;20000 per day

# --- World backups -----------------------------------------------------------
# Where Project Zomboid keeps its data. Saves are expected at
# $ZOMBOID_DATA_DIR/Saves/Multiplayer/<server name> - check this first if a
# backup comes back empty.
ZOMBOID_DATA_DIR=/home/steam/Zomboid
# RCON is a loopback connection: the game server runs beside the manager in the
# same container. Per-server port and password are set in the admin panel.
RCON_HOST=127.0.0.1
# Where start-server.sh lives. SteamCMD with +force_install_dir puts it at the
# install root; a library-style install puts it under
# steamapps/common/Project Zomboid Dedicated Server/. Override if the server
# will not launch.
SERVER_SCRIPT=
# --- Game server JVM ---------------------------------------------------------
# Project Zomboid installs with -Xmx8g and ZGC. If the machine cannot back that,
# the JVM is killed by the kernel partway through loading tile definitions - the
# log just stops and the manager restarts it in a loop.
#
# `auto` (the default) measures the container's memory limit, or the machine's
# memory if there is no limit, and takes half of it - the other half being the
# JVM's own overhead and whatever else shares the box. Clamped to 1g..8g.
# Set a size like 4g to decide yourself, or `keep` to leave the install alone.
GAME_SERVER_MAX_HEAP=auto
# Collector: `auto` picks by CPU count and heap size - Serial on 1-2 cores, ZGC
# only where its large-heap design pays off, G1 in between. Or name one
# yourself: Z, G1, Parallel, Serial. `keep` leaves the installed collector.
GAME_SERVER_GC=auto
# Where the game keeps its launch parameters (pzexe reads vmArgs from here).
# Only needed if the install layout differs.
LAUNCH_PARAMS_FILE=
# --- In-game item catalog ----------------------------------------------------
# Backs the item picker in Admin > Rewards and Admin > Give, so an item is
# chosen from a searchable list rather than typed from memory. Fetched from
# PZwiki's autogenerated item list (one request, ~4,600 items) and cached in
# Redis, refreshed when the stored copy is older than the TTL. Base-game items
# only - the wiki knows nothing about Workshop mods, so a modded id is still
# typed by hand.
ITEM_CATALOG_URL=https://pzwiki.net/w/index.php?title=PZwiki:Item_list&action=raw
ITEM_CATALOG_ICON_BASE=https://pzwiki.net/w/index.php?title=Special:FilePath/
# A week; item ids change only when the game does.
ITEM_CATALOG_TTL=604800
ITEM_CATALOG_TIMEOUT=30

# --- Steam Workshop metadata -------------------------------------------------
# Titles, thumbnails and short descriptions for Workshop item ids, from Steam's
# keyless GetPublishedFileDetails. Two things it buys you: a mod list you can
# read, and a check on whether an id exists at all - SteamCMD reports success
# for an id that does not, so without this a typo costs a several-minute
# download that fetched nothing.
#
# Set false on a host with no outbound HTTP. The panel then shows bare ids and
# every other part of mod management still works.
WORKSHOP_METADATA=true
# How long item details are cached (they change rarely), and how long a
# "no such item" is cached - far shorter, because the usual cause is a typo
# being corrected within the minute.
WORKSHOP_CACHE_TTL=86400
WORKSHOP_MISS_CACHE_TTL=600
# Seconds to wait on Steam before giving up and showing ids without titles.
WORKSHOP_API_TIMEOUT=10
# --- Alert delivery ----------------------------------------------------------
# The channels themselves are configured in Admin > Alerts, not here: which
# destinations exist and what each one listens to is operational, and lives in
# the database. These are the knobs for the relay that carries them.
#
# The relay runs in the game-server container because it is the only one with
# outbound access - the backend has none, deliberately - and it will only post
# to Discord's own webhook hosts.
WEBHOOK_TIMEOUT=10
# The Redis list the manager leaves player/server events on for the backend's
# scheduler to pick up. Change it in both services or neither.
WEBHOOK_EVENT_QUEUE=webhook:events
# Capped, so a scheduler that was down comes back to the recent past rather than
# an afternoon of stale arrivals; dropped entirely after the TTL with nothing
# draining it.
WEBHOOK_EVENT_QUEUE_MAX=500
WEBHOOK_EVENT_QUEUE_TTL=3600

BACKUP_DIR=/backups
# Archives kept per server after a new one is taken.
BACKUP_KEEP=10
# Seconds to let a running server flush to disk after `save` before archiving.
BACKUP_QUIESCE_SECONDS=10

# Task Management API Configuration
# Shared between the backend and the game-server manager. The manager reads it
# as MANAGER_API_TOKEN; the two must match.
API_TOKEN=changeme_secure_api_token
# Internal address of the game-server manager API (in-container port is 5000).
GAME_SERVER_API_URL=http://game-server:5000

# Frontend Configuration
# Build-time only, and deliberately left unset: the compose frontend talks to
# the backend same-origin and Nginx proxies /api, so nothing here needs a URL.
# Set it only if you build the frontend to point at a backend somewhere else -
# `npm start` uses the `proxy` field in package.json instead.
REACT_APP_API_URL=

# --- Outbound email -----------------------------------------------------------
# Read by the **game-server** container, not the backend. The backend composes
# the message and hands it over, because it has no egress and no DNS and cannot
# reach a mail server at all - which is why mail on earlier versions only ever
# reached the log.
#
# Leave SMTP_HOST blank to disable sending: messages are written to the backend
# log instead, so development works but password recovery becomes an operator
# task. An app-specific password from a consumer provider drops straight in.
#
# Alerts can be mailed to an ops address too - that is configured in
# Admin > Alerts and needs this to be set up first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=
# Seconds to wait on the mail server before giving up.
SMTP_TIMEOUT=15
# Where the browser reaches this deployment; used for links inside email.
SITE_URL=http://localhost:8080

# --- Site content ---------------------------------------------------------
# Defaults for what the public pages say. All of these are editable in the
# panel under Site, so these values only seed a fresh deployment.
SITE_BRAND_NAME=Project Safezone
SITE_HERO_TITLE=
SITE_HERO_SUBTITLE=
# Footer links. Blank means the icon is left out rather than pointing nowhere.
SITE_SOCIAL_DISCORD=
SITE_SOCIAL_TWITTER=
SITE_SOCIAL_YOUTUBE=
SITE_SOCIAL_STEAM=
# Markdown documents, published at /rules, /terms, /privacy and /cookies. Blank
# means the page says it has not been written yet, which is honest.
SITE_RULES=
SITE_LEGAL_TERMS=
SITE_LEGAL_PRIVACY=
SITE_LEGAL_COOKIES=

# --- Registration -------------------------------------------------------------
# Defaults only. An admin can change all of these in the panel at runtime, which
# is the point: closing signups is something you do during an incident.
REGISTRATION_ENABLED=true
# Blank = no shared password required to sign up.
REGISTRATION_PASSWORD=
INVITES_ENABLED=true
PLAYER_INVITES_ENABLED=false
PLAYER_INVITE_QUOTA=3
# Self-hosted challenge on the sign-up form. Stops drive-by bots; not a defence
# against a determined attacker - the registration gate above is that.
CAPTCHA_ENABLED=true

# --- Loot economy -------------------------------------------------------------
# A bonus box for accounts that collected at least STREAK_THRESHOLD of the week's
# seven daily boxes. Paid by the scheduler, dated to the day the week ended.
STREAK_BONUS_ENABLED=true
STREAK_THRESHOLD=5

# Unopened boxes and unsent rewards expire after this many days. 0 = never,
# which is the default: expiry is a lever you opt into, not one imposed on loot
# people already hold.
# Operational alerts for staff, and how long a raised alert stays quiet.
# Observability. LOG_FORMAT=json when something is collecting logs; plain text
# otherwise, because reading `docker compose logs` is the common case.
LOG_FORMAT=text
LOG_LEVEL=INFO
ALERTS_ENABLED=true
ALERT_COOLDOWN_MINUTES=60
# Warn the owner when a character link has not been seen this long. Never
# unlinks on its own. 0 disables.
DORMANT_LINK_DAYS=0

BOX_EXPIRY_DAYS=0
INVENTORY_EXPIRY_DAYS=0

# How often the scheduler looks for due work.
SCHEDULER_TICK_SECONDS=30

# Audit entries older than this are pruned. 0 keeps them forever.
AUDIT_RETENTION_DAYS=0
