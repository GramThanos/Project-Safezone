# Environment variables template
# Copy this file to .env and fill in your values

# Database Configuration (MariaDB)
DATABASE_HOST=db
DATABASE_NAME=safezone
DATABASE_USER=safezone
DATABASE_PASSWORD=changeme_secure_password
DATABASE_ROOT_PASSWORD=changeme_root_password

# Redis Configuration
REDIS_HOST=cache
REDIS_PORT=6379

# Backend API Configuration
SECRET_KEY=changeme_secure_secret_key_for_jwt
TOKEN_EXPIRY_HOURS=24
TOKEN_ISSUER=safezone-api
TOKEN_AUDIENCE=safezone-frontend

# Security Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
HTTPS_ENABLED=false
FLASK_DEBUG=false

# SteamCMD Configuration
STEAMCMD_PATH=/home/steam/steamcmd

# Monitoring Configuration
CHECK_INTERVAL=30

# Task Management API Configuration
API_TOKEN=changeme_secure_api_token
PROCESS_INTERVAL=5
GAME_SERVER_API_URL=http://game-server:5001

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000
